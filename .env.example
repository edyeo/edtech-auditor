# Copy to .env (local dev) or set in Vercel project settings.
# Without these, /api/explain falls back to a deterministic local explanation.

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required to use the /#/admin page (sent as X-Admin-Token). Without it admin endpoints return 503.
ADMIN_TOKEN=


# Local docker compose Postgres. Pick any value (letters/digits only keeps the URL simple).
POSTGRES_PASSWORD=

# Vercel / any hosted Postgres (Neon, Supabase, ...): set DATABASE_URL (pooled) in the project
# settings; for migrations also set DATABASE_URL_UNPOOLED (direct). Then run once per deploy:
#   python -m api.db.migrate
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require


# --- Sign-in (Supabase Auth) -------------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API (URL and public key) and JWT Keys / JWT Settings.
#
# Backend (api/): verifies the access token the browser sends as `Authorization: Bearer ...`.
#   Projects with JWT signing keys (asymmetric) only need the project URL; SUPABASE_URL is optional when
#   VITE_SUPABASE_URL below is set, because the backend falls back to it. A project that still uses the
#   legacy shared secret also needs SUPABASE_JWT_SECRET.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_SECRET=
#
# Frontend (public values, baked into the build): put them in frontend/.env.local for local dev and in
# the Vercel project settings for deploys.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon / publishable key>
